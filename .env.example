# ─── API ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# JWT
JWT_SECRET=change-this-secret-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# ─── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=comfort_nomad
DB_PASSWORD=comfort_nomad_password
DB_DATABASE=comfort_nomad_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── External APIs ─────────────────────────────────────────────────────────────
# Open-Meteo — free, no key needed
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Overpass API (OSM) — free, no key needed
OVERPASS_BASE_URL=https://overpass-api.de/api

# ─── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api
